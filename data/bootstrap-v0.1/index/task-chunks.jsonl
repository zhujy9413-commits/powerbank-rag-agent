{"chunk_id": "TR-P1-SUMMARY", "document_id": "SYN-TR-001-R1", "title": "模拟测试报告", "section": "P1-SUMMARY", "text": "报告填写依据RevA，恢复电压4.50 V至5.50 V。S01：C1保护响应80 ms，摘要填写通过。S02按上述电压区间填写通过。", "path": "task-reports/SYN-TR-001-R1.md", "page": 1, "version": "R1", "publication_status": "active", "material_type": "synthetic", "allowed_roles": ["engineer"], "scope": "task:DEMO-TASK-001", "source_id": null, "source_url": null, "verified_at": null, "applicable_market": "CN-mainland", "usage": "demo_only", "artifact_path": "output/pdf/SYN-TR-001-R1.pdf"}
